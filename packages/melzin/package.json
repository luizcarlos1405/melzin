{
  "name": "melzin",
  "version": "0.1.0",
  "description": "Melzin runtime: mount HTML views that are both the design and the production UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizcarlos1405/melzin.git",
    "directory": "packages/melzin"
  },
  "homepage": "https://github.com/luizcarlos1405/melzin#readme",
  "bugs": "https://github.com/luizcarlos1405/melzin/issues",
  "keywords": ["ui", "design", "html", "tailwindcss", "ai", "templates", "reactive"],
  "type": "module",
  "exports": {
    ".": { "bun": "./src/runtime/index.ts", "types": "./dist/runtime/index.d.ts", "default": "./dist/runtime/index.js" },
    "./core": { "bun": "./src/core/index.ts", "types": "./dist/core/index.d.ts", "default": "./dist/core/index.js" }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/bun": "^1.4.3",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2"
  }
}
