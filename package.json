{
  "name": "melzin-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/melzin build",
    "test": "bun run build && bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run --filter '*' check"
  }
}
